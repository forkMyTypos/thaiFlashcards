62"}, "audioA": {"src": "https://pub-1a03a552b5064c9990dda34518ab71aa.r2.dev/th/audio/TH_000162.mp3", "slow": "https://pub-1a03a552b5064c9990dda34518ab71aa.r2.dev/th/audio/TH_000162_slow.mp3", "text": "ถูก", "lang": "th"}}, {"sideA": "<div class=\"line\" style=\"text-align:center\"><span style=\"font-size:30px\">ลด</span></div><div class=\"line\" style=\"text-align:center\"><span style=\"font-size:64px\">📉</span></div><div class=\"line\" style=\"text-align:center\"><span style=\"font-size:16px;color:#60a5fa\">lót</span></div>", "sideB": "<div class=\"line\" style=\"text-align:center\"><span style=\"font-size:20px;font-weight:bold\">to reduce, decrease, lower, discount</span></div>", "sr": null, "bg": null, "fields": {"word": "ลด", "romanization": "lót", "meanings": "to reduce, decrease, lower, discount", "part_of_speech": "Verb", "emoji": "📉", "tone": "high", "id": "TH_000164"}, "audioA": {"src": "https://pub-1a03a552b5064c9990dda34518ab71aa.r2.dev/th/audio/TH_000164.mp3", "slow": "https://pub-1a03a552b5064c9990dda34518ab71aa.r2.dev/th/audio/TH_000164_slow.mp3", "text": "ลด", "lang": "th"}}, {"sideA": "<div class=\"line\" style=\"text-align:center\"><span style=\"font-size:30px\">เงิน</span></div><div class=\"line\" style=\"text-align:center\"><span class=\"img-run\" data-img-run=\"1\" style=\"display:inline-block;width:70%\"><img src=\"https://pub-1a03a552b5064c9990dda34518ab71aa.r2.dev/th/images/TH_000149.jpg\" style=\"width:100%\"/></span></div><div class=\"line\" style=\"text-align:center\"><span style=\"font-size:16px;color:#60a5fa\">ngoen</span></div>", "sideB": "<div class=\"line\" style=\"text-align:center\"><span style=\"font-size:20px;font-weight:bold\">money, silver</span></div>", "sr": null, "bg": null, "fields": {"word": "เงิน", "romanization": "ngoen", "ipa": "ŋɤn", "meanings": "money, silver", "part_of_speech": "Noun", "mnemonic": "A shiny silver urn overflowing with money.", "sentences": [{"text": "เอาเงินก่อน", "romanization": "ao ngoen gàawn", "tra