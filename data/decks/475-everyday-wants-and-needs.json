{"name": "Everyday wants and needs", "version": 2, "layout": {"front": ["word", "image", "romanization", "audio"], "back": ["meanings"]}, "cards": [{"sideA": "<div class=\"line\" style=\"text-align:center\"><span style=\"font-size:30px\">อยาก</span></div><div class=\"line\" style=\"text-align:center\"><span class=\"img-run\" data-img-run=\"1\" style=\"display:inline-block;width:70%\"><img src=\"https://pub-1a03a552b5064c9990dda34518ab71aa.r2.dev/th/images/TH_000417.jpg\" style=\"width:100%\"/></span></div><div class=\"line\" style=\"text-align:center\"><span style=\"font-size:16px;color:#60a5fa\">yàak</span></div>", "sideB": "<div class=\"line\" style=\"text-align:center\"><span style=\"font-size:20px;font-weight:bold\">to want to, would like to</span></div>", "sr": null, "bg": null, "fields": {"word": "อยาก", "romanization": "yàak", "meanings": "to want to, would like to", "part_of_speech": "Auxiliary verb; Verb", "sound_hook": "yak", "hook_visual": "a shaggy yak", "mnemonic": "A shaggy yak stares intensely at a giant plate of food because it desperately wants to eat it.", "sentences": [{"text": "คุณอยากกินอะไร", "romanization": "khun yàak gin à-rai", "translation": "What do you want to eat?"}, {"text": "คุณอยากกินปลาไหมครับ", "romanization": "khun yàak gin plaa mǎi khráp", "translation": "Would you like to eat fish?"}], "image": "https://pub-1a03a552b5064c9990dda34518ab71aa.r2.dev/th/images/TH_000417.jpg", "emoji": "💭", "tone": "low", "id": "TH_000417"}, "audioA": {"src": "https://pub-1a03a552b5064c9990dda34518ab71aa.r2.dev/th/audio/TH_000417.mp3", "slow": "https://pub-1a03a552b5064c9990dda34518ab71aa.r2.dev/th/audio/TH_000417_slow.mp3", "text": "อยาก", "lang": "th"}}, {"sideA": "<div class=\"line\" style=\"text-align:center\"><span style=\"font-size:30px\">ต้องการ</span></div><div class=\"line\" style=\"text-align:center\"><span style=\"font-size:64px\">❗</span></div><div class=\"line\" style=\"text-align:center\"><span style=\"font-size:16px;color:#60a5fa\">dtâw