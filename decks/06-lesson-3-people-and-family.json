.mp3", "text": "คือ", "lang": "th"}}, {"sideA": "<div class=\"line\" style=\"text-align:center\"><span style=\"font-size:30px\">ใคร</span></div><div class=\"line\" style=\"text-align:center\"><span style=\"font-size:64px\">❓</span></div><div class=\"line\" style=\"text-align:center\"><span style=\"font-size:16px;color:#60a5fa\">khrai</span></div>", "sideB": "<div class=\"line\" style=\"text-align:center\"><span style=\"font-size:20px;font-weight:bold\">who?, someone, anyone</span></div>", "sr": null, "bg": null, "fields": {"word": "ใคร", "romanization": "khrai", "ipa": "kʰraj", "meanings": "who?, someone, anyone", "part_of_speech": "Pronoun", "sound_hook": "cry", "hook_visual": "someone crying", "mnemonic": "A person crying while desperately looking around to find the unknown person they are searching for.", "sentences": [{"text": "เขาคือใครครับ", "romanization": "khǎo khue khrai khráp", "translation": "Who is he?"}, {"text": "คนนี้คือใครคะ", "romanization": "khon níi khue khrai khá", "translation": "Who is this person?"}], "emoji": "❓", "tone": "mid", "id": "TH_000599"}, "audioA": {"src": "https://pub-1a03a552b5064c9990dda34518ab71aa.r2.dev/th/audio/TH_000599.mp3", "slow": "https://pub-1a03a552b5064c9990dda34518ab71aa.r2.dev/th/audio/TH_000599_slow.mp3", "text": "ใคร", "lang": "th"}}]}